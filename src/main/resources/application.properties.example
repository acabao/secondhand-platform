# ===== 开发环境模板 — 复制为 application.properties 后填写真实值 =====
server.port=8080

# 数据库
spring.datasource.url=jdbc:mysql://localhost:3306/ylw?useUnicode=true&useSSL=false&characterEncoding=utf8&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# MyBatis
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.type-aliases-package=com.springboot.ylw.entity
mybatis.configuration.map-underscore-to-camel-case=true

# 文件上传
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=50MB

# Redis
spring.redis.host=localhost
spring.redis.port=6379
spring.redis.password=
spring.redis.database=0
spring.redis.timeout=3000ms
spring.redis.lettuce.pool.max-active=16
spring.redis.lettuce.pool.max-idle=8
spring.redis.lettuce.pool.min-idle=2
spring.redis.lettuce.pool.max-wait=2000ms

# 阿里云 OSS — 在 https://ram.console.aliyun.com 申请
aliyun.oss.endpoint=https://oss-cn-shenzhen.aliyuncs.com
aliyun.oss.access-key-id=YOUR_OSS_ACCESS_KEY_ID
aliyun.oss.access-key-secret=YOUR_OSS_ACCESS_KEY_SECRET
aliyun.oss.bucket-name=YOUR_BUCKET_NAME
aliyun.oss.url-prefix=https://YOUR_BUCKET.oss-cn-shenzhen.aliyuncs.com/

# 支付/短信网关：sandbox = 沙箱模拟（无需真实接入）
payment.gateway=sandbox
sms.gateway=sandbox

# 通义千问 DashScope — 在 https://dashscope.console.aliyun.com 申请
dashscope.api-key=YOUR_DASHSCOPE_API_KEY
dashscope.text-model=qwen-turbo
dashscope.vision-model=qwen-vl-plus
