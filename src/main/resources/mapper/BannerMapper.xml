<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.ylw.mapper.BannerMapper">

    <select id="selectAll" resultType="com.springboot.ylw.entity.Banner">
        SELECT * FROM banner WHERE status = 1 ORDER BY sort ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO banner (image, link, sort, status) VALUES (#{image}, #{link}, #{sort}, #{status})
    </insert>

    <update id="update">
        UPDATE banner
        <set>
            <if test="image != null">image = #{image},</if>
            <if test="link != null">link = #{link},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM banner WHERE id = #{id}
    </delete>

</mapper>
