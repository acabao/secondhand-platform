<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.ylw.mapper.CommentMapper">

    <resultMap id="BaseResultMap" type="com.springboot.ylw.entity.Comment">
        <id column="id" property="id"/>
        <result column="goods_id" property="goodsId"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="rating" property="rating"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByGoodsId" resultMap="BaseResultMap">
        SELECT * FROM comment WHERE goods_id = #{goodsId} ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comment (goods_id, user_id, content, rating) VALUES (#{goodsId}, #{userId}, #{content}, #{rating})
    </insert>

    <delete id="deleteById">
        DELETE FROM comment WHERE id = #{id}
    </delete>

</mapper>
