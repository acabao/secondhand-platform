<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.ylw.mapper.CommunityPostReplyMapper">

    <resultMap id="ReplyWithUser" type="com.springboot.ylw.entity.CommunityPostReply">
        <id     property="id"           column="id" />
        <result property="postId"       column="post_id" />
        <result property="userId"       column="user_id" />
        <result property="content"      column="content" />
        <result property="createTime"   column="create_time" />
        <result property="userNickname" column="user_nickname" />
        <result property="userAvatar"   column="user_avatar" />
    </resultMap>

    <select id="selectByPostId" resultMap="ReplyWithUser">
        SELECT r.*, u.nickname AS user_nickname, u.avatar AS user_avatar
        FROM community_post_reply r
        LEFT JOIN `user` u ON u.id = r.user_id
        WHERE r.post_id = #{postId}
        ORDER BY r.create_time ASC
    </select>

    <select id="selectById" resultMap="ReplyWithUser">
        SELECT r.*, u.nickname AS user_nickname, u.avatar AS user_avatar
        FROM community_post_reply r
        LEFT JOIN `user` u ON u.id = r.user_id
        WHERE r.id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO community_post_reply (post_id, user_id, content)
        VALUES (#{postId}, #{userId}, #{content})
    </insert>

    <delete id="deleteById">
        DELETE FROM community_post_reply WHERE id = #{id}
    </delete>

    <delete id="deleteByPostId">
        DELETE FROM community_post_reply WHERE post_id = #{postId}
    </delete>

</mapper>
