<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.ylw.mapper.FavoriteMapper">

    <resultMap id="BaseResultMap" type="com.springboot.ylw.entity.Favorite">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="goods_id" property="goodsId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM favorite WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <select id="selectByUserAndGoods" resultMap="BaseResultMap">
        SELECT * FROM favorite WHERE user_id = #{userId} AND goods_id = #{goodsId}
    </select>

    <insert id="insert">
        INSERT INTO favorite (user_id, goods_id) VALUES (#{userId}, #{goodsId})
    </insert>

    <delete id="deleteByUserAndGoods">
        DELETE FROM favorite WHERE user_id = #{userId} AND goods_id = #{goodsId}
    </delete>

</mapper>
