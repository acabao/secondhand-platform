// ===========================================================
// ER 图 模块 4：社区与运营
// 实体：用户 / 管理员 / 互助帖 / 帖子回复 / 私信 / 公告 / 轮播图
// 渲染： dot -Kneato -Tpng -Gcharset=utf8 er_4_community.dot -o er_4_community.png
// ===========================================================
graph ER_Community {
    graph [fontname="Microsoft YaHei", layout=neato, overlap=false,
           splines=true, sep="+14,14"];
    node  [fontname="Microsoft YaHei", fontsize=12];
    edge  [fontname="Microsoft YaHei", fontsize=11, len=1.4];

    // ===== 实体 =====
    node [shape=box, penwidth=1.6, width=1.4, height=0.6];
    user    [label="用户"];
    admin   [label="管理员"];
    post    [label="互助帖"];
    reply   [label="帖子回复"];
    message [label="私信"];
    notice  [label="公告"];
    banner  [label="轮播图"];

    // ===== 属性 =====
    node [shape=ellipse, penwidth=1];
    u_id    [label="id"];
    u_uname [label="用户名"];
    user -- u_id;
    user -- u_uname;

    a_id    [label="id"];
    a_uname [label="用户名"];
    admin -- a_id;
    admin -- a_uname;

    p_id      [label="id"];
    p_type    [label="类型"];
    p_title   [label="标题"];
    p_desc    [label="描述"];
    p_images  [label="图片"];
    p_loc     [label="位置"];
    p_status  [label="状态"];
    p_views   [label="浏览量"];
    p_replies [label="回复数"];
    post -- p_id;
    post -- p_type;
    post -- p_title;
    post -- p_desc;
    post -- p_images;
    post -- p_loc;
    post -- p_status;
    post -- p_views;
    post -- p_replies;

    rp_id      [label="id"];
    rp_content [label="内容"];
    rp_time    [label="创建时间"];
    reply -- rp_id;
    reply -- rp_content;
    reply -- rp_time;

    m_id      [label="id"];
    m_content [label="内容"];
    m_isread  [label="是否已读"];
    message -- m_id;
    message -- m_content;
    message -- m_isread;

    n_id      [label="id"];
    n_title   [label="标题"];
    n_content [label="内容"];
    n_status  [label="状态"];
    notice -- n_id;
    notice -- n_title;
    notice -- n_content;
    notice -- n_status;

    b_id     [label="id"];
    b_image  [label="图片"];
    b_link   [label="链接"];
    b_sort   [label="排序"];
    b_status [label="状态"];
    banner -- b_id;
    banner -- b_image;
    banner -- b_link;
    banner -- b_sort;
    banner -- b_status;

    // ===== 关系 =====
    node [shape=diamond, penwidth=1.6, width=1.2, height=0.7];
    r_post    [label="发帖"];
    r_contain [label="包含"];
    r_reply   [label="回帖"];
    r_send    [label="发送"];
    r_recv    [label="接收"];
    r_publish [label="发布"];

    user -- r_post    [label="1"]; r_post    -- post  [label="N"];
    post -- r_contain [label="1"]; r_contain -- reply [label="N"];
    user -- r_reply   [label="1"]; r_reply   -- reply [label="N"];

    user -- r_send [label="1"]; r_send -- message [label="N"];
    user -- r_recv [label="1"]; r_recv -- message [label="N"];

    admin -- r_publish [label="1"]; r_publish -- notice [label="N"];
}
