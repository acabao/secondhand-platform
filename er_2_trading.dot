// ===========================================================
// ER 图 模块 2：商品与交易
// 实体：用户 / 商品分类 / 商品 / 收货地址 / 自提点 / 订单 / 支付流水
// 关系含属性：收藏(M:N) / 评论(M:N)
// 渲染： dot -Kneato -Tpng -Gcharset=utf8 er_2_trading.dot -o er_2_trading.png
// ===========================================================
graph ER_Trading {
    graph [fontname="Microsoft YaHei", layout=neato, overlap=false,
           splines=true, sep="+14,14"];
    node  [fontname="Microsoft YaHei", fontsize=12];
    edge  [fontname="Microsoft YaHei", fontsize=11, len=1.5];

    // ===== 实体 =====
    node [shape=box, penwidth=1.6, width=1.4, height=0.6];
    user     [label="用户"];
    category [label="商品分类"];
    goods    [label="商品"];
    address  [label="收货地址"];
    pickup   [label="自提点"];
    ord      [label="订单"];
    payment  [label="支付流水"];

    // ===== 用户属性 =====
    node [shape=ellipse, penwidth=1];
    u_id    [label="id"];
    u_uname [label="用户名"];
    u_phone [label="手机号"];
    user -- u_id;
    user -- u_uname;
    user -- u_phone;

    // ===== 分类属性 =====
    c_id     [label="id"];
    c_name   [label="名称"];
    c_sort   [label="排序"];
    c_status [label="状态"];
    category -- c_id;
    category -- c_name;
    category -- c_sort;
    category -- c_status;

    // ===== 商品属性 =====
    g_id     [label="id"];
    g_title  [label="标题"];
    g_price  [label="价格"];
    g_desc   [label="描述"];
    g_images [label="图片"];
    g_cond   [label="新旧程度"];
    g_status [label="状态"];
    g_views  [label="浏览量"];
    goods -- g_id;
    goods -- g_title;
    goods -- g_price;
    goods -- g_desc;
    goods -- g_images;
    goods -- g_cond;
    goods -- g_status;
    goods -- g_views;

    // ===== 地址属性 =====
    ad_id    [label="id"];
    ad_recv  [label="收货人"];
    ad_phone [label="电话"];
    ad_dtl   [label="详细地址"];
    ad_def   [label="是否默认"];
    address -- ad_id;
    address -- ad_recv;
    address -- ad_phone;
    address -- ad_dtl;
    address -- ad_def;

    // ===== 自提点属性 =====
    p_id     [label="id"];
    p_name   [label="名称"];
    p_addr   [label="地址"];
    p_hours  [label="开放时间"];
    p_status [label="状态"];
    pickup -- p_id;
    pickup -- p_name;
    pickup -- p_addr;
    pickup -- p_hours;
    pickup -- p_status;

    // ===== 订单属性 =====
    o_id     [label="id"];
    o_no     [label="订单号"];
    o_price  [label="价格"];
    o_dtype  [label="配送方式"];
    o_status [label="状态"];
    o_pay    [label="支付时间"];
    ord -- o_id;
    ord -- o_no;
    ord -- o_price;
    ord -- o_dtype;
    ord -- o_status;
    ord -- o_pay;

    // ===== 支付属性 =====
    pm_id     [label="id"];
    pm_type   [label="支付方式"];
    pm_amt    [label="金额"];
    pm_trade  [label="交易号"];
    pm_status [label="状态"];
    payment -- pm_id;
    payment -- pm_type;
    payment -- pm_amt;
    payment -- pm_trade;
    payment -- pm_status;

    // ===== 关系（菱形）=====
    node [shape=diamond, penwidth=1.6, width=1.2, height=0.7];
    r_publish  [label="发布"];
    r_belong   [label="属于"];
    r_favorite [label="收藏"];
    r_comment  [label="评论"];
    r_own      [label="拥有"];
    r_buy      [label="买入"];
    r_sell     [label="卖出"];
    r_makeord  [label="成单"];
    r_ship     [label="邮寄至"];
    r_self     [label="自提"];
    r_pay      [label="支付"];

    user -- r_publish [label="1"]; r_publish -- goods [label="N"];
    goods -- r_belong [label="N"]; r_belong -- category [label="1"];

    user -- r_favorite [label="M"]; r_favorite -- goods [label="N"];
    user -- r_comment  [label="M"]; r_comment  -- goods [label="N"];

    user -- r_own [label="1"]; r_own -- address [label="N"];

    user -- r_buy  [label="1"]; r_buy  -- ord [label="N"];
    user -- r_sell [label="1"]; r_sell -- ord [label="N"];

    goods   -- r_makeord [label="1"]; r_makeord -- ord [label="N"];
    address -- r_ship    [label="1"]; r_ship    -- ord [label="N"];
    pickup  -- r_self    [label="1"]; r_self    -- ord [label="N"];

    ord -- r_pay [label="1"]; r_pay -- payment [label="N"];

    // ===== 关系自身的属性（虚线椭圆）=====
    node [shape=ellipse, style=dashed, penwidth=1];
    fav_id   [label="id"];
    fav_time [label="收藏时间"];
    r_favorite -- fav_id;
    r_favorite -- fav_time;

    cm_id      [label="id"];
    cm_content [label="内容"];
    cm_rating  [label="评分"];
    r_comment -- cm_id;
    r_comment -- cm_content;
    r_comment -- cm_rating;
}
