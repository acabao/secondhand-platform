// ===========================================================
// ER 图 模块 1：账号体系
// 实体：用户 / 管理员 / 短信验证码
// 渲染： dot -Kneato -Tpng -Gcharset=utf8 er_1_account.dot -o er_1_account.png
// ===========================================================
graph ER_Account {
    graph [fontname="Microsoft YaHei", layout=neato, overlap=false,
           splines=true, sep="+14,14"];
    node  [fontname="Microsoft YaHei", fontsize=12];
    edge  [fontname="Microsoft YaHei", fontsize=11, len=1.3];

    // ===== 实体（矩形）=====
    node [shape=box, penwidth=1.6, width=1.4, height=0.6];
    user   [label="用户"];
    admin  [label="管理员"];
    sms    [label="短信验证码"];

    // ===== 用户属性（椭圆）=====
    node [shape=ellipse, penwidth=1, width=0.9];
    u_id     [label="id"];
    u_uname  [label="用户名"];
    u_pwd    [label="密码"];
    u_nick   [label="昵称"];
    u_avatar [label="头像"];
    u_phone  [label="手机号"];
    u_email  [label="邮箱"];
    u_status [label="状态"];

    user -- u_id;
    user -- u_uname;
    user -- u_pwd;
    user -- u_nick;
    user -- u_avatar;
    user -- u_phone;
    user -- u_email;
    user -- u_status;

    // ===== 管理员属性 =====
    a_id    [label="id"];
    a_uname [label="用户名"];
    a_pwd   [label="密码"];
    a_role  [label="角色"];

    admin -- a_id;
    admin -- a_uname;
    admin -- a_pwd;
    admin -- a_role;

    // ===== 短信验证码属性 =====
    s_id      [label="id"];
    s_phone   [label="手机号"];
    s_code    [label="验证码"];
    s_purpose [label="用途"];
    s_expire  [label="过期时间"];
    s_used    [label="是否使用"];

    sms -- s_id;
    sms -- s_phone;
    sms -- s_code;
    sms -- s_purpose;
    sms -- s_expire;
    sms -- s_used;

    // ===== 关系（菱形）=====
    node [shape=diamond, penwidth=1.6, width=1.2, height=0.7];
    r_verify [label="验证"];
    r_manage [label="管理"];

    user     -- r_verify [label="1"];
    r_verify -- sms      [label="N"];

    admin    -- r_manage [label="1"];
    r_manage -- user     [label="N"];
}
